datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  KASIR
  SISWA
}

enum CategoryType {
  ATK
  JASA_PRINT
}

enum PrintColorType {
  BW
  COLOR
}

enum PrintOrderStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
}

model User {
  id           String        @id @default(uuid())
  nis          String?       @unique
  name         String
  email        String        @unique
  password     String
  role         Role          @default(SISWA)
  qrCodeMember String?       @unique @map("qr_code_member")
  points       Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  printOrders  PrintOrder[]  @relation("StudentPrintOrders")
  transactions Transaction[] @relation("StudentTransactions")
  handledTrans Transaction[] @relation("CashierTransactions")
  shifts       CashierShift[]

  @@map("users")
}

model Category {
  id       String       @id @default(uuid())
  name     String
  type     CategoryType @default(ATK)
  products Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  barcode      String?  @unique
  name         String
  description  String?  @db.Text
  hpp          Decimal  @db.Decimal(12, 2)
  margin       Decimal  @db.Decimal(5, 2)
  sellingPrice Decimal  @db.Decimal(12, 2) @map("selling_price")
  stock        Int      @default(0)
  minStock     Int      @default(5) @map("min_stock")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category         Category          @relation(fields: [categoryId], references: [id])
  transactionItems TransactionItem[]

  @@map("products")
}

model PrintOrder {
  id          String           @id @default(uuid())
  orderNumber String           @unique @map("order_number")
  studentId   String           @map("student_id")
  fileUrl     String           @map("file_url")
  fileName    String           @map("file_name")
  pageCount   Int              @map("page_count")
  colorType   PrintColorType   @map("color_type")
  paperSize   String           @map("paper_size")
  finishing   String?          
  totalPrice  Decimal          @db.Decimal(12, 2) @map("total_price")
  status      PrintOrderStatus @default(PENDING)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  student     User             @relation("StudentPrintOrders", fields: [studentId], references: [id])
  transaction TransactionItem?

  @@map("print_orders")
}

model Voucher {
  id          String   @id @default(uuid())
  code        String   @unique
  discountPct Decimal  @db.Decimal(5, 2) @map("discount_pct")
  maxDiscount Decimal? @db.Decimal(12, 2) @map("max_discount")
  minPurchase Decimal  @default(0) @db.Decimal(12, 2) @map("min_purchase")
  validUntil  DateTime @map("valid_until")
  isActive    Boolean  @default(true) @map("is_active")

  transactions Transaction[]

  @@map("vouchers")
}

model Transaction {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  cashierId      String        @map("cashier_id")
  studentId      String?       @map("student_id")
  voucherId      String?       @map("voucher_id")
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  payAmount      Decimal       @db.Decimal(12, 2) @map("pay_amount")
  changeAmount   Decimal       @db.Decimal(12, 2) @map("change_amount")
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  createdAt      DateTime      @default(now()) @map("created_at")

  cashier User              @relation("CashierTransactions", fields: [cashierId], references: [id])
  student User?             @relation("StudentTransactions", fields: [studentId], references: [id])
  voucher Voucher?          @relation(fields: [voucherId], references: [id])
  items   TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  productId     String?  @map("product_id")
  printOrderId  String?  @unique @map("print_order_id")
  itemName      String   @map("item_name")
  price         Decimal  @db.Decimal(12, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])
  printOrder  PrintOrder? @relation(fields: [printOrderId], references: [id])

  @@map("transaction_items")
}

model CashierShift {
  id         String    @id @default(uuid())
  cashierId  String    @map("cashier_id")
  startCash  Decimal   @db.Decimal(12, 2) @map("start_cash")
  endCash    Decimal?  @db.Decimal(12, 2) @map("end_cash")
  actualCash Decimal?  @db.Decimal(12, 2) @map("actual_cash")
  difference Decimal?  @db.Decimal(12, 2)
  startTime  DateTime  @default(now()) @map("start_time")
  endTime    DateTime? @map("end_time")

  cashier User @relation(fields: [cashierId], references: [id])

  @@map("cashier_shifts")
}